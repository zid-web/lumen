# --- Fournisseurs (choisis par variable d'env, jamais exposés au client) ---
# azure | elevenlabs | webspeech  (webspeech = le serveur ne synthétise pas, le client utilise speechSynthesis)
TTS_PROVIDER=azure
# deepl | azure | none
TRANSLATION_PROVIDER=deepl

# Azure Speech (Neural Voices)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# ElevenLabs (option premium)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_MALE=pNInz6obpgDQGcFmaJgB
ELEVENLABS_VOICE_FEMALE=21m00Tcm4TlvDq8ikWAM

# DeepL (clé gratuite = suffixe ":fx" → api-free.deepl.com automatiquement)
DEEPL_API_KEY=

# Azure Translator
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=westeurope

# Rate limiting distribué (sinon fallback mémoire par instance)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# CORS : origines autorisées, séparées par des virgules
ALLOWED_ORIGINS=https://lumen.example.com
